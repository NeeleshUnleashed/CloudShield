# ========================================================
# CloudShield Environment Configuration
# ========================================================
# STRICT POLICY: AWS_MODE must remain 'mock' during local development.
# Switching to 'live' requires explicit user authorization and approval.
AWS_MODE=mock

# Local Service Port & Host
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# Storage Paths for Local Mock Adapters
LOCAL_STORAGE_DIR=./data/local_storage
LOCAL_DB_PATH=./data/local_storage/cloudshield.db
LOCAL_QUEUE_DIR=./data/local_storage/queues
LOCAL_S3_DIR=./data/local_storage/s3

# Target AWS Region (Configured for future approved serverless operations)
AWS_REGION=ap-southeast-2

# Security Note: Never add actual AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here.
# Authentication is handled externally via the AWS CLI credential store when approved.
